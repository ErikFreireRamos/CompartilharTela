{
  "name": "compartilhador-de-tela",
  "productName": "CompartilhadorDeTela",
  "version": "0.1.0",
  "description": "Transmissão de tela com áudio entre amigos",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "setup:livekit": "node ../scripts/download-livekit.mjs",
    "build:audio": "powershell -ExecutionPolicy Bypass -File ../native/audio-capture/build.ps1",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "livekit-server-sdk": "^2.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "livekit-client": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
